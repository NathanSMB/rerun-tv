{
    "name": "rerun-tv",
    "version": "0.1.1",
    "description": "Turn a local media library into lean-back TV channels",
    "author": "Nathan Burchill",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NathanSMB/rerun-tv.git"
    },
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/main/index.js",
    "type": "module",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "start": "electron-vite preview",
        "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "test": "npm run rebuild:node --silent && vitest run",
        "test:coverage": "npm run rebuild:node --silent && vitest run --coverage",
        "test:watch": "vitest",
        "soak": "node scripts/soak.mjs",
        "rebuild:node": "npm rebuild better-sqlite3 && node -e \"require('node:fs').rmSync('node_modules/better-sqlite3/build/Release/.forge-meta', { force: true })\"",
        "rebuild:electron": "electron-rebuild -f -m . -o better-sqlite3",
        "dist": "npm run build && electron-builder --linux AppImage --publish never",
        "release": "npm run build && electron-builder --linux AppImage --publish always",
        "postinstall": "electron-builder install-app-deps",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/instrument-sans": "^5.3.0",
        "better-sqlite3": "^12.4.1",
        "chokidar": "^4.0.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.7.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "@vitest/coverage-v8": "^3.2.7",
        "babel-plugin-react-compiler": "^1.0.0",
        "electron": "^43.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^4.0.0",
        "happy-dom": "^20.11.1",
        "husky": "^9.1.7",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "typescript": "^7.0.2",
        "vite": "^7.1.5",
        "vitest": "^3.2.4",
        "zustand": "^5.0.8"
    },
    "build": {
        "appId": "tv.rerun.app",
        "productName": "Rerun TV",
        "directories": {
            "output": "release",
            "buildResources": "resources"
        },
        "afterPack": "./scripts/verify-native-abi.mjs",
        "files": [
            "dist/**/*",
            "resources/**/*",
            "package.json"
        ],
        "linux": {
            "icon": "icon.png",
            "target": [
                "AppImage"
            ],
            "category": "AudioVideo",
            "maintainer": "Nathan Burchill",
            "artifactName": "${name}-${version}-${arch}.AppImage"
        },
        "publish": {
            "provider": "github",
            "owner": "NathanSMB",
            "repo": "rerun-tv",
            "releaseType": "release"
        }
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true,
        "electron@43.2.0": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.1": true
    }
}
